<?xml version="1.0" encoding="UTF-8"?>
<!--
    Template for the "Import XML" button on the Tokens page.
    - One <token> element per token. <name> is required and must be unique (case-insensitive).
    - <grantType> is "authorization_code" or "client_credentials" (anything else falls back to authorization_code).
    - <accessToken> is optional: fill it with an already generated token, or leave it empty and use "Generate Token".
    - Do not commit real client secrets or access tokens to the repository.
-->
<tokens>
    <token>
        <name>access_token_ElAraby</name>
        <authUrl>https://webexapis.com/v1/authorize</authUrl>
        <accessTokenUrl>https://webexapis.com/v1/access_token</accessTokenUrl>
        <clientId>YOUR_CLIENT_ID</clientId>
        <clientSecret>YOUR_CLIENT_SECRET</clientSecret>
        <scope>cjp:config_read cjp:config_write cjp:config cjp:user</scope>
        <callbackUrl>https://amradel94.github.io/LocalRepositoryAmrTest/</callbackUrl>
        <grantType>authorization_code</grantType>
        <accessToken></accessToken>
    </token>
</tokens>
